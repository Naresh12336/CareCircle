# CareCircle Backend Environment Configuration
PROJECT_NAME="CareCircle"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Server
HOST="0.0.0.0"
PORT=8000

# CORS (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL="postgresql+psycopg2://carecircle:carecircle_secret@localhost:5432/carecircle_db"

# Storage
UPLOAD_DIR="storage/uploads"

# Security (Placeholder for future phases)
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
PASSCODE_SALT="replace-with-secure-salt"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / External Services (Optional / Non-clinical non-blocking)
GEMINI_API_KEY=""
